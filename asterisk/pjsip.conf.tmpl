; LAN only. Every endpoint needs the IPv4 RTP binding or audio fails one way on macOS (docs/build-notes.md fix 9).
[global]
type=global
user_agent=claude-phone

[udp]
type=transport
protocol=udp
bind=@@LAN_IP@@:5060

[acl]
type=acl
deny=0.0.0.0/0
permit=@@LAN_CIDR@@

[phone-endpoint](!)
type=endpoint
context=from-phone
disallow=all
allow=g722,ulaw,alaw
direct_media=no
media_address=@@LAN_IP@@
bind_rtp_to_media_address=yes
rtp_ipv6=no
mailboxes=owner@claude
send_pai=yes
trust_id_outbound=yes

[phone-aor](!)
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=10
qualify_timeout=2

; The iPhone (Linphone, Zoiper or any SIP app)
[@@PHONE_EXT@@](phone-endpoint)
auth=@@PHONE_EXT@@-auth
aors=@@PHONE_EXT@@
[@@PHONE_EXT@@-auth]
type=auth
auth_type=userpass
username=@@PHONE_EXT@@
password=@@SIP_PASSWORD@@
[@@PHONE_EXT@@](phone-aor)
